# Django Configuration
SECRET_KEY=django-insecure-spotter-fuel-route-optimizer-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL / PostGIS)
# Local or Docker PostgreSQL URL
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/fuel_optimizer_db

# External Services
OSRM_BASE_URL=https://router.project-osrm.org
FUEL_ROUTE_CORRIDOR_MILES=10
GEOCODING_USER_AGENT=SpotterFuelOptimizer/1.0

# Cache configuration
CACHE_TTL_SECONDS=86400
